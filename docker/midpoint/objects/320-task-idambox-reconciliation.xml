<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nightly at 02:00 UTC (D18), after the HR reconciliation: reads every IdamBox
  User the source can see (the connector pages past the 100-user default) and
  repairs drift from HR. Unowned manual users that match an HR person open a
  correlation case; nothing is linked or changed without an operator's decision.
-->
<task xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      oid="11000000-0000-4000-8000-000000000320">
    <name>IdamBox reconciliation (nightly)</name>
    <ownerRef oid="00000000-0000-0000-0000-000000000002" type="c:UserType"/>
    <executionState>runnable</executionState>
    <schedulingState>ready</schedulingState>
    <schedule>
        <recurrence>recurring</recurrence>
        <cronLikePattern>0 0 2 * * ?</cronLikePattern>
        <misfireAction>executeImmediately</misfireAction>
    </schedule>
    <activity>
        <work>
            <reconciliation>
                <resourceObjects>
                    <resourceRef oid="11000000-0000-4000-8000-000000000110"/>
                    <kind>account</kind>
                    <intent>default</intent>
                </resourceObjects>
            </reconciliation>
        </work>
        <controlFlow>
            <errorHandling>
                <!-- A person whose change fails is retried later, not only on the next run: a
                     durable retry trigger on their HR row, fired by midPoint's trigger
                     scanner, first after 5 minutes and then every 15 minutes, so a write
                     Strapi refused with 503 (Keycloak unavailable) completes on its own
                     once Keycloak is back (LIFE-04). -->
                <entry>
                    <situation>
                        <status>partial_error</status>
                        <status>fatal_error</status>
                    </situation>
                    <reaction>
                        <retryLater>
                            <initialInterval>PT5M</initialInterval>
                            <nextInterval>PT15M</nextInterval>
                        </retryLater>
                    </reaction>
                </entry>
            </errorHandling>
        </controlFlow>
    </activity>
</task>
