# Local-only settings for the idp compose project (docker/docker-compose.yaml).
# Copy to docker/.env (git-ignored) and replace every "change-me" value:
#
#   cp docker/.env.example docker/.env
#
# Values are literal KEY=VALUE lines; Docker Compose reads them for interpolation.
# Changing a value later does not rotate credentials already stored in a volume:
# reset with `docker compose down -v` (see docker/README.md).

# Keycloak bootstrap admin. The documented local default is admin / admin; the
# realm's test users and client secrets stay in docker/keycloak/import.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# midPoint repository (PostgreSQL 16, internal to the compose network).
MIDPOINT_DB_NAME=midpoint
MIDPOINT_DB_USER=midpoint
MIDPOINT_DB_PASSWORD=change-me

# midPoint console user "administrator" (http://127.0.0.1:8081/midpoint).
# Used only when the repository is first created.
MIDPOINT_ADMIN_PASSWORD=change-me

# Disposable backend PostgreSQL gate (opt-in iam-pg-gate profile).
IAM_PG_GATE_USER=iam_pg_gate
IAM_PG_GATE_PASSWORD=change-me
IAM_PG_GATE_DB=iam_pg_gate

# One-time development SCIM credential, delivered by scim:token --write-dev-env.
MIDPOINT_SCIM_TOKEN=
