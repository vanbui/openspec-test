/**
 * IdamBox IAM Data Model in JHipster Domain Language (JDL)
 *
 * Authorization path:
 *   IdamBoxUser -> Role -> ApplicationRole -> Application
 *
 * Product users are represented by IdamBoxUser, separate from Strapi admin users.
 */

entity IdamBoxUser {
  email String required unique,
  firstName String,
  lastName String,
  displayName String required,
  status IdamBoxUserStatus required,
  externalSubject String unique,
  password String // minLength 6; hashed at rest
}

enum IdamBoxUserStatus {
  ACTIVE,
  INACTIVE
}

entity Role {
  name String required unique,
  description TextBlob
}

entity Application {
  name String required unique,
  slug String required unique,
  description TextBlob,
  status ApplicationStatus required
}

enum ApplicationStatus {
  ACTIVE,
  INACTIVE
}

entity ApplicationRole {
  name String required,
  description TextBlob
}

/**
 * Relationships
 */
relationship ManyToMany {
  IdamBoxUser{roles} to Role{idamboxUsers},
  Role{applicationRoles} to ApplicationRole{roles}
}

relationship OneToMany {
  Application{applicationRoles} to ApplicationRole{application}
}

paginate IdamBoxUser, Role, Application, ApplicationRole with pagination
