  guid String required unique,
  version Long,
  createdDate Instant,
  createdBy String,
  lastModifiedDate Instant,
  lastModifiedBy String,
  enabled Boolean,
  type String,
  uid String required unique,
  displayName String,
  description TextBlob,
  imageUrl String,
  startDate LocalDate,
  endDate LocalDate,
  locked Boolean,
  status String,
  externalId String,
  systemOfRecord String,
  auditType String,
  accountTypeMatchPattern Integer
