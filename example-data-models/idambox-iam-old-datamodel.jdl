/**
 * Relationships
 */
relationship ManyToMany {
  Role{owners} to Group{ownedRoles},
  DynamicRole{owners} to Group{ownedDynamicRoles},
  Role{entitlementSets} to EntitlementSet{roles},
  DynamicRole{entitlementSets} to EntitlementSet{dynamicRoles},
  Role{entitlements} to Entitlement{roles},
  DynamicRole{entitlements} to Entitlement{dynamicRoles},
  Role{accountDefinitions} to AccountDefinition{roles},
  DynamicRole{accountDefinitions} to AccountDefinition{dynamicRoles},
  Organisation{owners} to Group{ownedOrganisations},
  Service{owners} to Group{ownedServices},
  Group{members} to User{groups},
  Account{entitlements} to Entitlement{accounts},
  EntitlementSet{entitlements} to Entitlement{entitlementSets},
  EntitlementSet{accountDefinitions} to AccountDefinition{entitlementSets}
}

relationship OneToMany {
  User{roleAssignments} to RoleAssignment{user},
  User{dynamicRoleAssignments} to DynamicRoleAssignment{user},
  Role{roleAssignments} to RoleAssignment{role},
  DynamicRole{dynamicRoleAssignments} to DynamicRoleAssignment{dynamicRole},
  Organisation{childOrganisations} to Organisation{parentOrganisation},
  Role{childRoles} to Role{parentRole},
  Service{accounts} to Account{service},
  Service{accountDefinitions} to AccountDefinition{service},
  Service{entitlements} to Entitlement{service}
}

relationship ManyToOne {
  User{organisation} to Organisation{users},
  User{person} to Person{users},
  User{manager} to User{managedUsers},
  User{delegate} to User{delegatedUsers},
  Account{user} to User{accounts}
}

paginate User, Person, Role, DynamicRole, Group, Organisation, Service, Account, AccountDefinition, Entitlement, EntitlementSet, RoleAssignment, DynamicRoleAssignment with pagination
