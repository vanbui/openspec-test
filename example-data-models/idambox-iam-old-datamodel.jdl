/**
 * Old IdamBox IAM Identity Server Data Model in JHipster Domain Language (JDL)
 *
 * Source:
 *   example-projects/idambox_old/idambox-server/src/main/java/org/idambox/identityserver/model
 *
 * Common persisted fields inherited from abstract superclasses (included on each entity below):
 *   AbstractBaseObject: guid, version, createdDate, createdBy, lastModifiedDate,
 *     lastModifiedBy, enabled, namedAttributes (JSON list of NamedAttribute)
 *   AbstractGenericObject: type, uid, displayName, description, imageUrl, startDate,
 *     endDate, locked, status, externalId, systemOfRecord, auditType
 *
 * Notes:
 *   - Java @Entity User maps to table ib_user (user is a SQL reserved word).
 *   - Role and DynamicRole use JPA SINGLE_TABLE inheritance on ib_role with
 *     discriminator column type_discriminator. Modelled here as separate entities.
 *   - @Transient fields (encryptedPassword, *IdRef, forceProcessing, skipProcessing,
 *     canonicalUid setters) are omitted because they are not persisted.
 */

/**
 * Embeddable value object stored as JSON on AbstractBaseObject.namedAttributes
 */
/*
component NamedAttribute {
  name String,
  value String
}
*/

enum RoleInheritanceType {
  TOP_DOWN,
  BOTTOM_UP,
  NO_INHERITANCE
}

entity User {
  guid String required unique,
  version Long,
  createdDate Instant,
  createdBy String,
  lastModifiedDate Instant,
  lastModifiedBy String,
  enabled Boolean,
  type String,
  uid String required unique,
  displayName String,
  description TextBlob,
  imageUrl String,
  startDate LocalDate,
  endDate LocalDate,
  locked Boolean,
  status String,
  externalId String,
  systemOfRecord String,
  auditType String,
  password String,
  firstName String,
  middleName String,
  lastName String,
  preferredName String,
  company String,
  division String,
  department String,
  jobCode String,
  title String,
  gender String,
  address String,
  phoneNumber String,
  email String,
  personalEmail String,
  dateOfBirth LocalDate,
  lastLogin Instant
}

entity Person {
  guid String required unique,
  version Long,
  createdDate Instant,
  createdBy String,
  lastModifiedDate Instant,
  lastModifiedBy String,
  enabled Boolean,
  type String,
  uid String required unique,
  displayName String,
  description TextBlob,
  imageUrl String,
  startDate LocalDate,
  endDate LocalDate,
  locked Boolean,
  status String,
  externalId String,
  systemOfRecord String,
  auditType String,
  password String,
  firstName String,
  middleName String,
  lastName String,
  preferredName String,
  title String,
  gender String,
  address String,
  phoneNumber String,
  email String,
  personalEmail String,
  dateOfBirth LocalDate,
  lastLogin Instant
}

entity Role {
  guid String required unique,
  version Long,
  createdDate Instant,
  createdBy String,
  lastModifiedDate Instant,
  lastModifiedBy String,
  enabled Boolean,
  type String,
  uid String required unique,
  displayName String,
  description TextBlob,
  imageUrl String,
  startDate LocalDate,
  endDate LocalDate,
  locked Boolean,
  status String,
  externalId String,
  systemOfRecord String,
  auditType String,
  accessUrl String,
  selfSubscribable Boolean,
  multiRequestable Boolean,
  selfSubscriptionMetadata TextBlob,
  workflowProcessName String,
  workflowProcessVersion String,
  visibilityRule String,
  validityPeriod Integer,
  inheritanceType RoleInheritanceType
}

entity DynamicRole {
  guid String required unique,
  version Long,
  createdDate Instant,
  createdBy String,
  lastModifiedDate Instant,
  lastModifiedBy String,
  enabled Boolean,
  type String,
  uid String required unique,
  displayName String,
  description TextBlob,
  imageUrl String,
  startDate LocalDate,
  endDate LocalDate,
  locked Boolean,
  status String,
  externalId String,
  systemOfRecord String,
  auditType String,
  dynamicRoleMembershipRule TextBlob,
  membershipCalculationEnabled Boolean
}

entity Group {
  guid String required unique,
  version Long,
  createdDate Instant,
  createdBy String,
  lastModifiedDate Instant,
  lastModifiedBy String,
  enabled Boolean,
  type String,
  uid String required unique,
  displayName String,
  description TextBlob,
