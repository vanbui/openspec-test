/**
 * Tutoring LMS Data Model in JHipster Domain Language (JDL)
 */

entity LMSUser {
  firstName String required,
  lastName String required,
  email String required unique,
  contactNumber String,
  username String required unique,
  auth0UserId String unique,
  password String,
  role LMSUserRole required,
  guardianName String,
  guardianEmail String,
  guardianContactNumber String
}

enum LMSUserRole {
  STUDENT,
  TUTOR
}

entity Class {
  className String required,
  description String,
  startDate Instant,
  endDate Instant,
  zoomLink String,
  classDayTime String
}

entity Announcement {
  title String required,
  bodyText TextBlob,
  startTime Instant,
  endTime Instant,
  targetAudience TargetAudience required,
  image Media // Strapi collection attribute type
}

enum TargetAudience {
  STUDENTS_ONLY,
  TUTOR_ONLY,
  EVERYONE
}

entity Module {
  title String required,
  description String,
  orderIndex Integer required
}

entity Material {
  description String,
  pdf Media required // Strapi collection attribute type
}

entity WritingHomework {
  title String required,
  promptText TextBlob required,
  promptImage Media required // Strapi collection attribute type
  releaseDate Instant,
  dueDate Instant,
  level Integer
}

entity Criterion {
  name String required,
  // tiers Component[rubric.tier] required repeatable // Strapi component attribute type
}

entity WritingHomeworkSubmission {
  submissionText TextBlob required,
  submittedAt Instant,
  aiFeedback TextBlob,
  aiCorrection TextBlob,
  aiRubric TextBlob,
  tutorFeedback TextBlob,
  tutorCorrection TextBlob,
  tutorRubric TextBlob,
  finalScore Integer,
  markedAt Instant
}

entity HomeworkVideo {
  title String required,
  description TextBlob,
  videoFile Media,
  vimeoVideoId String,
  vimeoEmbedUrl String,
  vimeoThumbnailUrl String,
  videoDuration Integer,
  uploadDate Instant,
  uploadStatus UploadStatus
}

entity ClassRecording {
  title String required,
  description TextBlob,
  videoFile Media,
  vimeoVideoId String,
  vimeoEmbedUrl String,
  vimeoThumbnailUrl String,
  videoDuration Integer,
  uploadDate Instant,
  uploadStatus UploadStatus
}

enum UploadStatus {
  PENDING,
  UPLOADING,
  COMPLETED,
  FAILED
}

/**
 * Single type
 */
entity WritingHomeworkAI {
  feedbackPrompt TextBlob,
  rubricPrompt TextBlob,
  correctionPrompt TextBlob
}


/**
 * Components
 */
/*
component rubric.tier {
  points Integer required,
  description TextBlob required
}
*/

/**
 * Relationships
 */
relationship ManyToMany {
  Class{announcements} to Announcement{classes}
  Class{modules} to Module{classes}
  Class{lmsUsers} to LMSUser{classes}
  Criterion{writingHomeworks} to WritingHomework{criteria}
}

relationship OneToMany {
  Module{classRecordings} to ClassRecording{module}
  Module{materials} to Material{module}
  Module{writingHomeworks} to WritingHomework{module}
  Module{homeworkVideos} to HomeworkVideo{module}

  WritingHomework{writingHomeworkSubmissions} to WritingHomeworkSubmission{writingHomework}
  LMSUser{writingHomeworkSubmissions} to WritingHomeworkSubmission{student}
  LMSUser to WritingHomeworkSubmission{tutor}
}

paginate Class, LMSUser, Announcement, Module, Material, HomeworkVideo, ClassRecording, WritingHomework, WritingHomeworkSubmission, Criterion with pagination
// paginate Module, Material, HomeworkVideo with infinite-scroll
