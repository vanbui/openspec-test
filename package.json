{
  "name": "idambox-platform",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "develop": "turbo run dev",
    "develop:cms": "yarn workspace backend develop",
    "build:cms": "yarn workspace backend build",
    "start": "yarn workspace backend start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "check-types": "turbo run check-types",
    "verify:schema": "node scripts/verify-core-model.mjs",
    "verify:csrm-model": "node scripts/verify-csrm-model.mjs",
    "verify:csrm-seed": "node scripts/verify-csrm-seed.mjs",
    "verify:keycloak-idp": "node scripts/verify-keycloak-idp.mjs",
    "verify:keycloak-provisioning": "node scripts/verify-keycloak-provisioning.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "turbo": "^2.5.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
