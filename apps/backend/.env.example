HOST=0.0.0.0
PORT=1337

# Generate fresh comma-separated values before running locally.
APP_KEYS=replace-with-key-1,replace-with-key-2
API_TOKEN_SALT=replace-with-api-token-salt
ADMIN_JWT_SECRET=replace-with-admin-jwt-secret
TRANSFER_TOKEN_SALT=replace-with-transfer-token-salt
ENCRYPTION_KEY=replace-with-32-character-encryption-key

# Local development defaults to SQLite.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# PostgreSQL example for later environments.
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=idambox
# DATABASE_USERNAME=idambox
# DATABASE_PASSWORD=idambox
# DATABASE_SSL=false
# DATABASE_SCHEMA=public

# Optional local sample records for manual verification.
IDAMBOX_SEED_CORE=true
IDAMBOX_SEED_CSRM=false

# Optional CSRM backend application-facing routes.
csrmAppIsEnabled=false

# Optional Strapi-to-Keycloak user provisioning.
# These local-only values target the idp/keycloak/import/idambox-realm.json seed.
IDAMBOX_KEYCLOAK_PROVISIONING=false
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=idambox
KEYCLOAK_ADMIN_CLIENT_ID=idambox-strapi-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=idambox-strapi-admin-local-secret
