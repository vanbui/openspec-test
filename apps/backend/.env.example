HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Optional local sample records for manual verification.
IDAMBOX_SEED_CORE=true
IDAMBOX_SEED_CSRM=true

# Development-only persisted identity bridge. Keep disabled by default.
CSRM_DEV_IDENTITY=true
CSRM_ENVIRONMENT=development

# Test-only deterministic API credential bootstrap. Leave unset for ordinary
# local development; isolated tests set it only with all development gates.
CSRM_DEV_API_TOKEN=

# Optional CSRM backend application-facing routes.
csrmAppIsEnabled=true

# Browser origins allowed to read Strapi responses cross-origin. Leave empty: no
# browser needs it (the web calls Strapi server-side and the admin panel is served
# from Strapi's own origin), and empty grants no other origin. List exact origins,
# comma-separated (https://admin.csrm.example.com), only for a browser client served
# from another origin. Wildcards, null and paths stop the boot. A listed origin may
# send credentials, admin sessions included, so list only an origin you trust as
# much as the admin panel.
CSRM_CORS_ALLOWED_ORIGINS=

# Set to true to enable AI completion transcript diagnostics. This is useful for debugging and understanding the AI's reasoning process, but may expose sensitive information. Keep it disabled in production environments.
CSRM_AI_COMPLETION_TRANSCRIPT_DIAGNOSTICS=false

# AI provider defaults to deterministic when these values remain commented.
# To use the local Ollama qwen3.5:9b model, copy this block into .env and
# remove the leading "# " from every assignment. Do not commit .env.
#
# Local Ollama (OpenAI-compatible) configuration using the qwen3.5:9b model. Uncomment and configure as needed.
# CSRM_AI_PROVIDER=openai-compatible
# CSRM_AI_PROVIDER_LABEL=openai-compatible
# CSRM_AI_STRUCTURED_OUTPUT=true
# CSRM_AI_REQUEST_TIMEOUT_MS=60000
# CSRM_AI_REASONING_EFFORT=
# CSRM_AI_ASSESSMENT_BASE_URL=http://127.0.0.1:11434/v1
# CSRM_AI_ASSESSMENT_API_KEY=
# CSRM_AI_ASSESSMENT_MODEL=qwen3.5:9b
# CSRM_AI_ASSESSMENT_MAX_OUTPUT_TOKENS=8000
# CSRM_AI_QUESTIONNAIRE_BASE_URL=http://127.0.0.1:11434/v1
# CSRM_AI_QUESTIONNAIRE_API_KEY=
# CSRM_AI_QUESTIONNAIRE_MODEL=qwen3.5:9b
# CSRM_AI_QUESTIONNAIRE_MAX_OUTPUT_TOKENS=16000

# Example OpenAI configuration (gpt-5.6-terra)
# CSRM_AI_PROVIDER=openai-compatible
# CSRM_AI_PROVIDER_LABEL=openai-compatible
# CSRM_AI_STRUCTURED_OUTPUT=true
# CSRM_AI_REQUEST_TIMEOUT_MS=60000
# CSRM_AI_REASONING_EFFORT=
# CSRM_AI_ASSESSMENT_BASE_URL=https://api.openai.com/v1
# CSRM_AI_ASSESSMENT_API_KEY=sk-proj-4s443TFkXXXXXXXXXXXXXXXXXXXXXXXX
# CSRM_AI_ASSESSMENT_MODEL=gpt-5.6-terra
# CSRM_AI_ASSESSMENT_MAX_OUTPUT_TOKENS=16000
# CSRM_AI_QUESTIONNAIRE_BASE_URL=https://api.openai.com/v1
# CSRM_AI_QUESTIONNAIRE_API_KEY=sk-proj-4s443TFkXXXXXXXXXXXXXXXXXXXXXXXX
# CSRM_AI_QUESTIONNAIRE_MODEL=gpt-5.6-terra
# CSRM_AI_QUESTIONNAIRE_MAX_OUTPUT_TOKENS=16000