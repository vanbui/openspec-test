HOST=0.0.0.0
PORT=1337

# Generate fresh comma-separated values before running locally.
APP_KEYS=replace-with-key-1,replace-with-key-2
API_TOKEN_SALT=replace-with-api-token-salt
ADMIN_JWT_SECRET=replace-with-admin-jwt-secret
TRANSFER_TOKEN_SALT=replace-with-transfer-token-salt
ENCRYPTION_KEY=replace-with-32-character-encryption-key

# Local development defaults to SQLite.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# PostgreSQL example for later environments.
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=idambox
# DATABASE_USERNAME=idambox
# DATABASE_PASSWORD=idambox
# DATABASE_SSL=false
# DATABASE_SCHEMA=public

# Optional local sample records for manual verification.
IDAMBOX_SEED_CORE=false
