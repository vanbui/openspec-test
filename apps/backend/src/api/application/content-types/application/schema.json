{
  "kind": "collectionType",
  "collectionName": "idambox_applications",
  "info": {
    "singularName": "application",
    "pluralName": "applications",
    "displayName": "Application",
    "description": "IdamBox platform application module"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "required": true
    },
    "applicationRoles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::application-role.application-role",
      "mappedBy": "application"
    }
  }
}
