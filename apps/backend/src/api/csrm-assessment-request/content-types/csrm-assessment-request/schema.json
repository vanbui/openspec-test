{
  "kind": "collectionType",
  "collectionName": "csrm_assessment_requests",
  "info": {
    "singularName": "csrm-assessment-request",
    "pluralName": "csrm-assessment-requests",
    "displayName": "CSRM Assessment Request",
    "description": "Cyber security risk management assessment request"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "requestNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "assessmentType": {
      "type": "enumeration",
      "enum": [
        "BAU",
        "Project",
        "Other"
      ]
    },
    "division": {
      "type": "string"
    },
    "businessUnit": {
      "type": "string"
    },
    "businessPurpose": {
      "type": "text"
    },
    "businessCriticality": {
      "type": "enumeration",
      "enum": [
        "Low",
        "Moderate",
        "High",
        "Critical"
      ]
    },
    "thirdPartyInvolvement": {
      "type": "boolean"
    },
    "thirdPartyDetails": {
      "type": "text"
    },
    "regulatoryRequirements": {
      "type": "text"
    },
    "requestor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::idambox-user.idambox-user"
    },
    "sponsor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::idambox-user.idambox-user"
    },
    "submittedDate": {
      "type": "datetime"
    },
    "revertReason": {
      "type": "text"
    },
    "revertedAt": {
      "type": "datetime"
    },
    "revertedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::idambox-user.idambox-user"
    },
    "assignedAnalyst": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::idambox-user.idambox-user",
      "private": true
    },
    "assignedAt": {
      "type": "datetime",
      "private": true
    },
    "assignedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::idambox-user.idambox-user",
      "private": true
    },
    "assignmentLog": {
      "type": "json",
      "private": true
    },
    "dueDate": {
      "type": "date"
    },
    "requestStatus": {
      "type": "enumeration",
      "enum": [
        "draft",
        "submitted",
        "questionnaire-in-progress",
        "risk-assessment-drafted",
        "under-review",
        "approved",
        "closed"
      ],
      "default": "draft",
      "required": true
    },
    "informationAssets": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::csrm-information-asset.csrm-information-asset",
      "inversedBy": "assessmentRequests"
    },
    "informationSystems": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::csrm-information-system.csrm-information-system",
      "inversedBy": "assessmentRequests"
    },
    "questionnaire": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::csrm-questionnaire.csrm-questionnaire",
      "mappedBy": "assessmentRequest"
    },
    "assessment": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::csrm-assessment.csrm-assessment",
      "mappedBy": "assessmentRequest"
    }
  }
}
