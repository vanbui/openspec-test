{
  "kind": "collectionType",
  "collectionName": "idambox_roles",
  "info": {
    "singularName": "role",
    "pluralName": "roles",
    "displayName": "Role",
    "description": "Reusable bundle of IdamBox functions"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "description": {
      "type": "text"
    },
    "functions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::function.function",
      "inversedBy": "roles"
    },
    "idamboxUsers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::idambox-user.idambox-user",
      "mappedBy": "roles"
    }
  }
}
