{
  "kind": "collectionType",
  "collectionName": "idambox_entitlements",
  "info": {
    "singularName": "entitlement",
    "pluralName": "entitlements",
    "displayName": "Entitlement",
    "description": "Entitlement defined by a specific IdamBox application"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "application": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::application.application",
      "inversedBy": "entitlements",
      "required": true
    },
    "roles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::role.role",
      "mappedBy": "entitlements"
    }
  }
}
