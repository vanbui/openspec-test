{
  "kind": "collectionType",
  "collectionName": "csrm_questionnaires",
  "info": {
    "singularName": "csrm-questionnaire",
    "pluralName": "csrm-questionnaires",
    "displayName": "CSRM Questionnaire",
    "description": "Questionnaire attached to a CSRM assessment request"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "questionnaireNumber": {
      "type": "string",
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "generatedDate": {
      "type": "datetime"
    },
    "generatedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::idambox-user.idambox-user"
    },
    "providerName": {
      "type": "string"
    },
    "providerVersion": {
      "type": "string"
    },
    "assessmentRequest": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::csrm-assessment-request.csrm-assessment-request",
      "inversedBy": "questionnaire"
    },
    "questions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::csrm-question.csrm-question",
      "mappedBy": "questionnaire"
    },
    "revertReason": {
      "type": "text"
    },
    "revertedAt": {
      "type": "datetime"
    },
    "revertedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::idambox-user.idambox-user"
    },
    "releasedAt": {
      "type": "datetime"
    },
    "releasedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::idambox-user.idambox-user"
    },
    "governanceLog": {
      "type": "json"
    }
  }
}
