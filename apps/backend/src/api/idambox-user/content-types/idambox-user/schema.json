{
  "kind": "collectionType",
  "collectionName": "idambox_users",
  "info": {
    "singularName": "idambox-user",
    "pluralName": "idambox-users",
    "displayName": "IdamBox User",
    "description": "Product user represented inside the IdamBox platform"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "username": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "displayName": {
      "type": "string",
      "required": true
    },
    "accountStatus": {
      "type": "enumeration",
      "enum": ["active", "inactive"],
      "default": "active",
      "required": true
    },
    "externalSubject": {
      "type": "string",
      "unique": true
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "private": true
    },
    "identitySource": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::identity-source.identity-source"
    },
    "sourceExternalId": { "type": "string", "maxLength": 255 },
    "sourceIdentityKey": { "type": "string", "private": true, "unique": true, "minLength": 64, "maxLength": 64 },
    "employeeNumber": { "type": "string", "maxLength": 255 },
    "department": { "type": "string", "maxLength": 255 },
    "jobTitle": { "type": "string", "maxLength": 255 },
    "sourceDeletedAt": { "type": "datetime" },
    "lastSyncedAt": { "type": "datetime" },
    "protected": { "type": "boolean", "required": true, "default": false },
    "roles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::role.role",
      "inversedBy": "idamboxUsers"
    }
  }
}
