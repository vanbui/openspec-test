{
  "kind": "collectionType",
  "collectionName": "csrm_controls",
  "info": {
    "singularName": "csrm-control",
    "pluralName": "csrm-controls",
    "displayName": "CSRM Control",
    "description": "Reusable CSRM control definition"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "controlNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "controlType": {
      "type": "enumeration",
      "enum": [
        "Preventive",
        "Detective",
        "Corrective",
        "Compensating"
      ]
    },
    "controlReference": {
      "type": "string"
    },
    "implementations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::csrm-control-implementation.csrm-control-implementation",
      "mappedBy": "control"
    }
  }
}
