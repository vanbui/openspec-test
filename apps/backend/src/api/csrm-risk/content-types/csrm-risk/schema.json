{
  "kind": "collectionType",
  "collectionName": "csrm_risks",
  "info": {
    "singularName": "csrm-risk",
    "pluralName": "csrm-risks",
    "displayName": "CSRM Risk",
    "description": "Risk identified during a CSRM assessment"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "riskNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "issueStatement": {
      "type": "text"
    },
    "riskStatement": {
      "type": "text",
      "required": true
    },
    "riskCategory": {
      "type": "string"
    },
    "riskSubCategory": {
      "type": "string"
    },
    "riskCause": {
      "type": "text"
    },
    "potentialImpact": {
      "type": "text"
    },
    "riskType": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::csrm-risk-type.csrm-risk-type",
      "inversedBy": "risks"
    },
    "riskOwner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::idambox-user.idambox-user"
    },
    "informationSystemImpacted": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::csrm-information-system.csrm-information-system"
    },
    "informationAssetImpacted": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::csrm-information-asset.csrm-information-asset"
    },
    "dataClassification": {
      "type": "enumeration",
      "enum": [
        "Public",
        "Internal",
        "Restricted",
        "Critical Infrastructure Sensitive"
      ]
    },
    "inherentLikelihood": {
      "type": "string"
    },
    "highestInherentConsequence": {
      "type": "string"
    },
    "inherentRating": {
      "type": "string"
    },
    "inherentRatingRationale": {
      "type": "text"
    },
    "residualLikelihood": {
      "type": "string"
    },
    "highestResidualConsequence": {
      "type": "string"
    },
    "residualRating": {
      "type": "string"
    },
    "residualRatingRationale": {
      "type": "text"
    },
    "controlEffectiveness": {
      "type": "enumeration",
      "enum": [
        "Effective",
        "Partially Effective",
        "Ineffective",
        "Not Assessed"
      ]
    },
    "riskVelocity": {
      "type": "enumeration",
      "enum": [
        "Low",
        "Moderate",
        "High",
        "Very High"
      ]
    },
    "identifiedDate": {
      "type": "date"
    },
    "targetDate": {
      "type": "date"
    },
    "closureDate": {
      "type": "date"
    },
    "isExempted": {
      "type": "boolean"
    },
    "exemptionReviewDate": {
      "type": "datetime"
    },
    "escalationDetails": {
      "type": "text"
    },
    "comments": {
      "type": "text"
    },
    "riskCommunicationDate": {
      "type": "date"
    },
    "treatmentAction": {
      "type": "enumeration",
      "enum": [
        "Accept",
        "Treat"
      ]
    },
    "treatmentPlan": {
      "type": "text"
    },
    "treatmentOwner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::idambox-user.idambox-user"
    },
    "treatmentResolveDate": {
      "type": "date"
    },
    "treatmentStatus": {
      "type": "enumeration",
      "enum": [
        "Not Started",
        "In Progress",
        "Overdue",
        "Complete"
      ]
    },
    "withdrawnAt": {
      "type": "datetime"
    },
    "withdrawnBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::idambox-user.idambox-user"
    },
    "withdrawalReason": {
      "type": "text"
    },
    "controlImplementations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::csrm-control-implementation.csrm-control-implementation",
      "mappedBy": "risk"
    },
    "assessment": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::csrm-assessment.csrm-assessment",
      "inversedBy": "risks"
    },
    "aiProvenance": {
      "type": "json"
    }
  }
}
