CSRM_API_BASE_URL=http://localhost:1337/api
CSRM_DEV_IDENTITY=true

# Full access Strapi API token (admin panel > Settings > API Tokens). Required
# whenever the development identity bridge is enabled; keep it in ignored local
# environment configuration and never expose it to browser code.
CSRM_API_TOKEN=copy-strapi-api-token-from-admin-panel

# Production-only Keycloak OIDC sign-in (docs/adr/0003-production-only-keycloak-oidc-sign-in.md).
#
# Keep it false or unset for local development and coding agents: the development
# sign-in above keeps working, no Keycloak is needed, and no AUTH_* value is read.
# Set it true only for production deployments.
#
# Until Strapi verifies Keycloak identity server-side (the tracked follow-up), a
# production build refuses to start with it set to true, while `next dev` signs in
# against the local Keycloak in idp/.
#
# With it true, the development identity bridge above is off and CSRM_DEV_IDENTITY
# is ignored.
CSRM_AUTH_OIDC_ENABLED=false

# The five AUTH_* values below are only read when CSRM_AUTH_OIDC_ENABLED=true. The
# server fails fast at startup naming any missing or malformed value.
#
# AUTH_URL must be the exact browser origin Keycloak has registered; use localhost,
# not 127.0.0.1.
# AUTH_URL=http://localhost:3000
#
# Generate with `openssl rand -base64 32`, at least 32 characters. Never commit it.
# AUTH_SECRET=
#
# AUTH_KEYCLOAK_ID=idambox-csrm
#
# The local-only value from idp/README.md. Never reuse it outside local
# development; production reads it from a secret store.
# AUTH_KEYCLOAK_SECRET=idambox-csrm-local-secret
#
# AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/idambox
