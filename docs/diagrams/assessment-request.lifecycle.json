  "cards": [
    {
      "dot": "cyan",
      "title": "Who moves it",
      "items": [
        "Requestor submits, or reverts SUBMITTED only before a questionnaire exists",
        "Saving the first answers to a released questionnaire starts QUESTIONNAIRE_IN_PROGRESS",
        "Analyst drafts, reviews and releases the assessment"
      ]
    },
    {
      "dot": "amber",
      "title": "Guarded gates",
      "items": [
        "Every transition is checked server-side in Strapi, with 409 on a wrong status",
        "Release needs UNDER_REVIEW plus validateReleaseReadiness",
        "AI drafts stay advisory: only an analyst release sets APPROVED"
      ]
    },
    {
      "dot": "rose",
      "title": "Model gap",
      "items": [
        "CLOSED is in the JDL and schema enum, but no service writes it",
        "Editing a reviewed assessment regresses only the assessment, never the request",
        "Enum: draft, submitted, questionnaire-in-progress, risk-assessment-drafted, under-review, approved, closed"
      ]
    }
  ]
