  "cards": [
    {
      "dot": "cyan",
      "title": "How it moves",
      "items": [
        "AI draft generation creates the assessment as draft, advisory only",
        "An analyst's first accepted edit sets in-review and stamps reviewedBy",
        "Only an analyst release sets approved with approvedBy + approvalDate"
      ]
    },
    {
      "dot": "amber",
      "title": "Guarded gates",
      "items": [
        "Release needs in-review, reviewer, summary, rating, rationale and risks",
        "Editing a release-ready assessment regresses it to draft",
        "Any release fact makes the record immutable: edits return 409"
      ]
    },
    {
      "dot": "rose",
      "title": "Model gap",
      "items": [
        "Release Ready and Review Withdrawn are derived, not enum values",
        "closed is in the JDL and schema enum, but no service writes it",
        "Enum: draft, in-review, approved, closed"
      ]
    }
  ]
