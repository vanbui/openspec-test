  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Server Components call Strapi only through the typed API layer",
        "API token and caller identity stay server-side, never in the browser",
        "Strapi is the single production API boundary: no frontend facade"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Policy enforces Role, Function, FunctionAPI plus record ownership",
        "Release and questionnaire governance: human Security Analyst only",
        "Navigation visibility is never authorisation"
      ]
    },
    {
      "dot": "amber",
      "title": "External dependencies",
      "items": [
        "Keycloak hook is commented out; dev identity header is used today",
        "AI questionnaire and assessment drafts run in-process in Strapi",
        "CSRM_AI_PROVIDER defaults to a deterministic offline provider"
      ]
    }
  ]
